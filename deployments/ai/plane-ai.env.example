# Copy to plane-ai.env next to docker-compose.ai.yml and fill in secrets.
# Generate the gateway key with: openssl rand -hex 32

AI_GATEWAY_LOG_LEVEL=INFO
AI_GATEWAY_GATEWAY_API_KEY=

# Plane public API (internal Docker network). Keep `http://api:8000`.
AI_GATEWAY_PLANE_API_BASE_URL=http://api:8000
# Service-account API token (Plane > Settings > API tokens)
AI_GATEWAY_PLANE_API_KEY=

# LLM (DeepSeek by default; OpenAI-compatible)
AI_GATEWAY_LLM_PROVIDER=deepseek
AI_GATEWAY_LLM_API_KEY=
AI_GATEWAY_LLM_BASE_URL=https://api.deepseek.com
AI_GATEWAY_LLM_MODEL=deepseek-chat

# Retrieval DB (Phase 3). Connection string to the plane-ai-db service:
#   postgresql+asyncpg://plane_ai:<password>@plane-ai-db:5432/plane_ai
AI_GATEWAY_DATABASE_URL=

# Embeddings (OpenAI-compatible /embeddings endpoint). Empty key => keyword-only.
AI_GATEWAY_EMBEDDING_PROVIDER=openai-compatible
AI_GATEWAY_EMBEDDING_API_KEY=
AI_GATEWAY_EMBEDDING_BASE_URL=https://api.openai.com/v1
AI_GATEWAY_EMBEDDING_MODEL=text-embedding-3-small
AI_GATEWAY_EMBEDDING_DIM=1536
AI_GATEWAY_RETRIEVAL_TOP_K=5

# AI DB credentials (used by plane-ai-db)
AI_DB_USER=plane_ai
AI_DB_PASSWORD=
AI_DB_NAME=plane_ai
